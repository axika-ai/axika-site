/*
  X-Robots-Tag: all
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Scripts may only load as files from this origin: no inline scripts, no third-party
  # sources. Embedding anything external (booking widget, video) needs its origin added here.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'

/site.webmanifest
  Content-Type: application/manifest+json
