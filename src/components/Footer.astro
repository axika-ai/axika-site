---
// Shared dark footer. `home` is '' on the landing page (in-page anchors)
// and '/' on the legal pages (anchors resolve back to the index).
interface Props {
	home?: string;
}

const { home = '' } = Astro.props;
---

<footer><div class="wrap">
<div class="fgrid">
<div>
<span class="logo inv" aria-label="AXIKA"><span><svg viewBox="0 0 100 100"><path d="M29.83 8.66A46 46 0 1 1 15.82 19.22L16.84 27.63A40 40 0 1 0 37.64 11.96Z" fill="currentColor"></path></svg></span><span>AXIKA</span><span>AI</span></span>
<p class="ftag">Industrial R&amp;D reimagined for the age of abundant intelligence.</p>
</div>
<div><h4>Company</h4><div class="flist"><a href={`${home}#shift`}>The shift</a><a href={`${home}#technology`}>The technology</a><a href={`${home}#approach`}>The approach</a></div></div>
<div><h4>Contact</h4><div class="flist"><a href="mailto:hello@axika.ai">hello@axika.ai</a><a href={`${home}#contact`}>Get in touch</a><span>Press &amp; speaking</span></div></div>
<div><h4>Legal</h4><div class="flist"><a href="/privacy">Privacy</a><a href="/terms">Terms</a></div></div>
</div>
<div class="fbot"><span>© 2026 AXIKA AI Inc. · San Francisco</span><span class="tagfoot">Design Autonomy for Industrial R&amp;D</span></div>
</div></footer>
