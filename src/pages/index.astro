---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import heroRing from '../assets/hero-ring-v2.png';
import contactRing from '../assets/contact-ring-dark.png';
import '../styles/landing.css';

const buildDate = new Date().toISOString().slice(0, 10);
const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': 'https://axika.ai/#org',
			name: 'AXIKA AI',
			legalName: 'AXIKA AI Inc.',
			url: 'https://axika.ai/',
			logo: 'https://axika.ai/og.png',
			slogan: 'Design Autonomy for Dark Factories',
			description:
				'AXIKA AI builds Design Autonomy for Dark Factories in Advanced Manufacturing — specialised AI that designs, engineers and validates industrial products on the engineering tools manufacturers already run.',
			foundingDate: '2026-05',
			foundingLocation: { '@type': 'Place', name: 'San Francisco, California, USA' },
			address: { '@type': 'PostalAddress', addressLocality: 'San Francisco', addressRegion: 'CA', addressCountry: 'US' },
			founder: { '@id': 'https://axika.ai/#founder' },
			email: 'hello@axika.ai',
			sameAs: ['https://www.linkedin.com/company/axika-ai', 'https://github.com/axika-ai'],
			knowsAbout: [
				'Design autonomy',
				'Dark factories',
				'Advanced manufacturing',
				'Industrial AI',
				'Agentic engineering',
				'Computer-aided engineering',
				'Product lifecycle management',
			],
		},
		{
			'@type': 'Person',
			'@id': 'https://axika.ai/#founder',
			name: 'Pina Schlombs',
			jobTitle: 'Founder & CEO',
			worksFor: { '@id': 'https://axika.ai/#org' },
			alumniOf: { '@type': 'CollegeOrUniversity', name: 'Technische Universität Berlin' },
			sameAs: ['https://www.linkedin.com/in/pinaschlombs/'],
			description:
				'Founder and CEO of AXIKA AI. Previously built the Industrial AI business at Siemens Digital Industries Software; R&D engineer at Siemens Energy and Volkswagen.',
		},
		{
			'@type': 'WebSite',
			'@id': 'https://axika.ai/#website',
			url: 'https://axika.ai/',
			name: 'AXIKA AI',
			publisher: { '@id': 'https://axika.ai/#org' },
			inLanguage: 'en',
		},
		{
			'@type': 'WebPage',
			'@id': 'https://axika.ai/#home',
			url: 'https://axika.ai/',
			name: 'AXIKA — Design Autonomy for Dark Factories',
			isPartOf: { '@id': 'https://axika.ai/#website' },
			about: { '@id': 'https://axika.ai/#org' },
			dateModified: buildDate,
		},
	],
};
---

<Layout
	title="AXIKA — Design Autonomy for Dark Factories"
	description="AXIKA AI builds Design Autonomy for Dark Factories in Advanced Manufacturing — specialised AI that designs, engineers and validates industrial products on the engineering tools manufacturers already run."
>

<header>
<div class="wrap hrow">
<div class="hbrand"><a href="#top" class="logo" aria-label="AXIKA"><span><svg fill="currentColor"><use href="#mark"></use></svg></span><span>AXIKA</span><span>AI</span></a><span class="htag">Design Autonomy for Dark Factories</span></div>
<nav>
<a class="lk" href="#build">what we build</a>
<a class="navcta" href="#contact">get in touch</a>
<a id="menuBtn" class="navcta" href="#top" role="button" aria-label="menu">menu</a>
</nav>
</div>
</header>

<div class="hero" id="top">
<div class="stage">
<div class="bg"><Image id="hero-bg" class="bgimg" src={heroRing} alt="AXIKA ring mark" quality={85} loading="eager" fetchpriority="high" /><div class="scrim"></div></div>
<div class="heroTxt">
<h1>Design Autonomy for<br />Dark Factories.</h1>
<p class="taglineHero">Specialized AI moving atoms at speed and precision.</p>
</div>
</div>
</div>

<section id="build"><div class="wrap">
<div class="cardhead">
<span class="eyebrow bullet">what we build</span>
<h2 class="sec">Products designed to be built with no one on the floor.</h2>
</div>
<div class="cards">
<div class="card"><p class="body">Dark factories run without people on the shop floor. They need products engineered, validated and certified at machine speed — and born manufacturable.</p><p class="body">AXIKA's specialized AI agents do that work on the engineering tools manufacturers already run, grounded in the company's own design history, factory and supply chain. Humans set the intent and sign the result.</p></div>
<div class="card"><p class="body">Built for advanced manufacturing: complex products, thousands of parts, high variant count, hard compliance.</p><p class="body">Design autonomy means AI systems carry a product from design intent through engineering, validation and certification, with people only at intent and sign-off.</p></div>
</div>
</div></section>

<div class="dark">
<div class="darkbg"><Image id="contact-bg" class="bgimg" src={contactRing} alt="AXIKA ring mark" quality={85} loading="lazy" /></div>
<section id="contact" style="border:0;position:relative">
<div class="wrap contact">
<div style="display:flex;flex-direction:column">
<div style="display:flex;align-items:center;justify-content:space-between;gap:24px"><span class="chip">contact us</span></div>
<h2>Building for dark factories?<br />Let's talk.</h2>
<p class="taglineDark">Design Autonomy for Dark Factories</p>
</div>
<form id="contactForm" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
<p class="hidden" aria-hidden="true"><label>Don't fill this out if you're human: <input name="bot-field" /></label></p>
<div class="field"><input name="name" type="text" placeholder="Name" autocomplete="name" required /></div>
<div class="field"><input name="email" type="email" placeholder="Email" autocomplete="email" required /></div>
<div class="field"><input name="company" type="text" placeholder="Company name" autocomplete="organization" /></div>
<div class="field"><textarea name="message" rows="2" placeholder="Tell us more about yourself and your goals…" required></textarea></div>
<button type="submit">Submit</button>
<p class="formnote" id="formnote">We handle your details as described in our <a href="/privacy">Privacy Policy</a>.</p>
</form>
</div></section>

<Footer />
</div>

{/* A file, not inline: the Content-Security-Policy in public/_headers blocks inline scripts. */}
<script is:inline src="/scripts/landing.js" defer></script>

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

</Layout>
