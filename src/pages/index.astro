---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import heroRing from '../assets/hero-ring-v2.png';
import contactRing from '../assets/contact-ring-dark.png';
import '../styles/landing.css';
---

<Layout
	title="AXIKA — Design Autonomy for Dark Factories"
	description="AXIKA AI builds Design Autonomy for Dark Factories in Advanced Manufacturing — specialised AI that designs, engineers and validates industrial products on the engineering tools manufacturers already run."
>

<header>
<div class="wrap hrow">
<div class="hbrand"><a href="#top" class="logo" aria-label="AXIKA"><span><svg fill="currentColor"><use href="#mark"></use></svg></span><span>AXIKA</span><span>AI</span></a><span class="htag">Design Autonomy for Dark Factories</span></div>
<nav>
<a class="lk" href="#build">what we build</a>
<a class="navcta" href="#contact">get in touch</a>
<a id="menuBtn" class="navcta" href="#top" role="button" aria-label="menu">menu</a>
</nav>
</div>
</header>

<div class="hero" id="top">
<div class="stage">
<div class="bg"><Image id="hero-bg" class="bgimg" src={heroRing} alt="" quality={85} loading="eager" fetchpriority="high" /><div class="scrim"></div></div>
<div class="heroTxt">
<h1>Design Autonomy for<br />Dark Factories.</h1>
<p class="taglineHero">Specialized AI moving atoms at speed and precision.</p>
</div>
</div>
</div>

<section id="build"><div class="wrap">
<div class="cardhead">
<span class="eyebrow bullet">what we build</span>
<h2 class="sec">Products designed to be built with no one on the floor.</h2>
</div>
<div class="cards">
<div class="card"><p class="body">Dark factories run without people on the shop floor. They need products engineered, validated and certified at machine speed — and born manufacturable.</p><p class="body">AXIKA's specialized AI agents do that work on the engineering tools manufacturers already run, grounded in the company's own design history, factory and supply chain. Humans set the intent and sign the result.</p></div>
<div class="card"><p class="body">Built for advanced manufacturing: complex products, thousands of parts, high variant count, hard compliance.</p></div>
</div>
</div></section>

<div class="dark">
<div class="darkbg"><Image id="contact-bg" class="bgimg" src={contactRing} alt="" quality={85} loading="lazy" /></div>
<section id="contact" style="border:0;position:relative">
<div class="wrap contact">
<div style="display:flex;flex-direction:column">
<div style="display:flex;align-items:center;justify-content:space-between;gap:24px"><span class="chip">contact us</span></div>
<h2>Building for dark factories?<br />Let's talk.</h2>
<p class="taglineDark">Design Autonomy for Dark Factories</p>
</div>
<form id="contactForm" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
<p class="hidden" aria-hidden="true"><label>Don't fill this out if you're human: <input name="bot-field" /></label></p>
<div class="field"><input name="name" type="text" placeholder="Name" autocomplete="name" required /></div>
<div class="field"><input name="email" type="email" placeholder="Email" autocomplete="email" required /></div>
<div class="field"><input name="company" type="text" placeholder="Company name" autocomplete="organization" /></div>
<div class="field"><textarea name="message" rows="2" placeholder="Tell us more about yourself and your goals…" required></textarea></div>
<button type="submit">Submit</button>
<p class="formnote" id="formnote">We handle your details as described in our <a href="/privacy">Privacy Policy</a>.</p>
</form>
</div></section>

<Footer />
</div>

<script is:inline>
document.getElementById('menuBtn').addEventListener('click',function(e){e.preventDefault();this.closest('nav').classList.toggle('open')});
document.querySelectorAll('nav a.lk').forEach(function(a){a.addEventListener('click',function(){a.closest('nav').classList.remove('open')})});
/* Fit the dark-panel ring image so its top edge lands on the Name field and its
   bottom edge on the Press & speaking row, at any viewport width. The ring
   occupies y 0.102-0.884 of the source image. */
(function(){
  var slot=document.getElementById('contact-bg'),dark=document.querySelector('.dark');
  if(!slot||!dark)return;
  var TOP=0.102,BOT=0.884,AR=1536/1024;
  function fit(){
    if(innerWidth<=1000){slot.style.removeProperty('--ringTop');slot.style.removeProperty('--ringW');return}
    var name=document.querySelector('#contactForm input[name=name]');
    var press=[].slice.call(document.querySelectorAll('footer .flist span')).filter(function(s){return /press/i.test(s.textContent)})[0];
    if(!name||!press)return;
    var d=dark.getBoundingClientRect(),T=name.getBoundingClientRect().top-d.top,B=press.getBoundingClientRect().bottom-d.top;
    /* Cap the RING's width (it spans x 0.409-0.890 of the source), not the whole
       image box — the empty left backdrop may clip past the panel edge. */
    var h=(B-T)/(BOT-TOP),w=h*AR,max=d.width*0.72/0.481;
    if(w>max){w=max;h=w/AR}
    slot.style.setProperty('--ringW',w.toFixed(1)+'px');
    slot.style.setProperty('--ringTop',(T-TOP*h).toFixed(1)+'px');
  }
  fit();addEventListener('resize',fit);
  if(document.fonts&&document.fonts.ready)document.fonts.ready.then(fit);
})();
/* Analytics events: section visibility (event name + section id) and form
   submission (event name only). Never attach form field contents or any
   other personal data to an event. */
(function(){
  window.plausible=window.plausible||function(){(window.plausible.q=window.plausible.q||[]).push(arguments)};
  var seen={};
  var obs=new IntersectionObserver(function(entries){entries.forEach(function(e){
    if(e.isIntersecting&&!seen[e.target.id]){seen[e.target.id]=1;plausible('Section View: '+e.target.id);obs.unobserve(e.target)}
  })},{threshold:0.2});
  ['build','contact'].forEach(function(id){var el=document.getElementById(id);if(el)obs.observe(el)});
  var f=document.getElementById('contactForm');
  if(f)f.addEventListener('submit',function(){plausible('Contact Form Submit')});
})();
</script>

<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "AXIKA AI Inc.",
  "alternateName": "AXIKA",
  "url": "https://axika.ai/",
  "logo": "https://axika.ai/assets/axika-logo.png",
  "email": "hello@axika.ai",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "San Francisco",
    "addressRegion": "CA",
    "addressCountry": "US"
  }
}
</script>

</Layout>
